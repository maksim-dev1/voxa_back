# nexus: storage-relay + worker share this file (docker-compose.yml env_file)

DATABASE_URL=postgres://maksim:CHANGEME@192.168.0.155:5438/voxa?sslmode=disable
REDIS_URL=redis://:CHANGEME@192.168.0.155:6379/2

# storage-relay
RECORDINGS_DIR=/data/voxa/recordings
ADDR=:8100

# worker
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8
# pyannote/speaker-diarization-3.1 is a gated HF model — accept the license
# on huggingface.co and put a read token here, otherwise the worker fails
# to load the diarization pipeline on first start.
HF_TOKEN=
